# 生产配置样例：复制为未跟踪的本地文件（例如 config/prod.yaml）后再填值。
# 秘密项不写在这里，只从环境变量读取：
#   EDGEPULSE_DB_PASSWORD
#   EDGEPULSE_REDIS_PASSWORD
#   EDGEPULSE_OPS_BEARER_TOKEN
#   EDGEPULSE_AGENT_FINGERPRINT
#   EDGEPULSE_INITIAL_PASSWORD
edgepulse:
  listen_address: 0.0.0.0
  threads: 1
  hot_reload: true
  # HA 部署必须显式配置且各实例唯一（例如 edgepulse-1、edgepulse-2）；留空时按
  # hostname-pid-random 生成，能启动但无法稳定区分日志与租约持有人。Docker HA 编排
  # 由入口脚本按 EDGEPULSE_INSTANCE_ID 写入本项。
  instance_id: ""
  ha:
    # 声明这是多实例部署；租约与单飞本身不依赖此开关，打开后日志会标记 HA 模式。
    enabled: false
  http_port: 8080
  # 由 nginx 终止 TLS 时改为 0，只保留 8080 给代理；Agent 仍直连 9443。
  https_port: 8443
  agent_port: 9443
  ops_port: 9100
  # 容器或 Prometheus 要跨网络抓取时必须绑 0.0.0.0；只在本机抓取可改回 127.0.0.1
  ops_address: 0.0.0.0
  web_root: web
  cert_dir: /etc/edgepulse/tls
  # HA 下所有实例必须挂同一个共享固件卷；本地卷会让上传与下载落到不同实例。
  firmware_dir: /var/lib/edgepulse/firmware
  maximum_firmware_bytes: 268435456
  firmware:
    # 生产必须签名；trusted_keys_dir 指向只含公钥的绝对路径，目录为空时启动失败
    require_signature: true
    trusted_keys_dir: /etc/edgepulse/firmware-keys
  telemetry_retention_days: 30
  log_retention_days: 90
  delivery_retention_days: 30
  database:
    # HA 下所有实例必须连同一个 MySQL；迁移由 GET_LOCK 串行化，SQLite 只支持单实例。
    driver: mysql
    host: mysql
    port: 3306
    name: edgepulse
    user: edgepulse
  redis:
    # HA 必须启用共享 Redis：会话、验证码、登录失败计数与跨实例 Agent 命令路由都依赖它。
    enabled: true
    host: redis
    port: 6379
    database: 0
  migrations_dir: migrations
  captcha:
    ttl_seconds: 120
    expose_code: false
    requests_per_minute: 30
  session:
    ttl_seconds: 7200
  security:
    # 浏览器直接访问负载均衡地址；HA 下不要写成某个实例的地址。
    allowed_origins: https://console.example.com
    # 打开后跳过整个私网/保留段分类：普通私网、回环、CGNAT、组播、保留与文档示例段（含 IPv6 唯一本地）
    # 都会放行；云元数据与链路本地地址始终拒绝
    allow_private_webhooks: false
    # 建号、重置与改密共用：至少 10 位且同时包含大写、小写、数字与符号
    password_min_length: 10
    password_require_complexity: true
    # 账号在窗口内连续失败 5 次锁定 15 分钟
    login_failure_window_seconds: 900
    login_max_failures: 5
    login_lock_seconds: 900
  agent:
    fingerprint: ""
    enrollment_mode: "required"
    heartbeat_interval_seconds: 30
    heartbeat_timeout_seconds: 90
    offline_sweep_seconds: 30
  agent_ca:
    # 默认关闭。启用后控制面用这里的 CA 为 Agent 自动签发证书。
    # certificate_file 必须就是 9443 监听器信任的锚（cert_dir/ca.pem）；ca.pem 是拼接信任包时，
    # 该 CA 证书必须包含在其中，启动时按 SHA-256 指纹比对，对不上直接拒绝启动。
    # 私钥单独挂载，不随配置、镜像或公开证书卷分发；宿主机权限 0400，容器内只读。
    # Docker HA 编排把它挂在 /run/secrets/agent_ca_key，单机部署可用
    # /etc/edgepulse/agent-ca-key.pem（同样要求 0400 且仅服务账号可读）。
    enabled: false
    certificate_file: /etc/edgepulse/tls/ca.pem
    key_file: /run/secrets/agent_ca_key
    validity_days: 30
    overlap_hours: 24
  udp_telemetry:
    enabled: false
    address: 0.0.0.0
    port: 9555
  oidc:
    enabled: false
    issuer: https://idp.example.com
    client_id: edgepulse
    redirect_uri: https://console.example.com/api/auth/oidc/callback
    frontend_redirect: /login
    scopes: openid profile email
    allowed_email_domains: ""
    auto_provision: false
    default_role_id: 0
    default_dept_id: 101
    tenant_code: default
  reverse_proxy:
    enabled: false
    prefix: /edge
    upstream: http://127.0.0.1:9000
    strip_prefix: true
    require_session: true
    permission: ""
    timeout_ms: 15000
    maximum_request_bytes: 8388608
    maximum_response_bytes: 8388608

server:
  limits:
    idle_timeout_ms: 75000
    read_timeout_ms: 60000
    write_timeout_ms: 60000
  quic:
    idle_timeout_seconds: 30  # h3 传输层空闲超时，1..3600；server.limits.idle_timeout_ms 不控制 h3
  parser_limits:
    maximum_body_size: 268435456
  rate_limit:
    # 令牌桶按实例计数。若目标总速率是 R，N 个实例应各配 R/N；burst_capacity 同样除以 N。
    # 反向代理不解析 X-Forwarded-For，代理后的请求会共享代理出口的限频与登录失败计数。
    requests_per_second: 0.0  # 整数与小数均可（如 10 或 0.5）；0 关闭
    burst_capacity: 1.0

metrics:
  enabled: false
  service_name: EdgePulse
  service_version: 1.0.0
  export_interval_ms: 15000
  otlp:
    endpoint: http://otel-collector:4318/v1/metrics
    timeout_ms: 3000
