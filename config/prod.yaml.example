# 生产配置样例：复制为未跟踪的本地文件（例如 config/prod.yaml）后再填值。
# 秘密项不写在这里，只从环境变量读取：
#   EDGEPULSE_DB_PASSWORD
#   EDGEPULSE_REDIS_PASSWORD
#   EDGEPULSE_OPS_BEARER_TOKEN
#   EDGEPULSE_AGENT_FINGERPRINT
#   EDGEPULSE_INITIAL_PASSWORD
edgepulse:
  listen_address: 0.0.0.0
  threads: 1
  hot_reload: true
  http_port: 8080
  https_port: 8443
  agent_port: 9443
  ops_port: 9100
  # 容器或 Prometheus 要跨网络抓取时必须绑 0.0.0.0；只在本机抓取可改回 127.0.0.1
  ops_address: 0.0.0.0
  web_root: web
  cert_dir: /etc/edgepulse/tls
  firmware_dir: /var/lib/edgepulse/firmware
  maximum_firmware_bytes: 268435456
  telemetry_retention_days: 30
  database:
    driver: mysql
    host: mysql
    port: 3306
    name: edgepulse
    user: edgepulse
  redis:
    enabled: true
    host: redis
    port: 6379
    database: 0
  migrations_dir: migrations
  captcha:
    ttl_seconds: 120
    expose_code: false
    requests_per_minute: 30
  session:
    ttl_seconds: 7200
  security:
    allowed_origins: https://console.example.com
  agent:
    fingerprint: ""
  udp_telemetry:
    enabled: false
    address: 0.0.0.0
    port: 9555
  oidc:
    enabled: false
    issuer: https://idp.example.com
    client_id: edgepulse
    redirect_uri: https://console.example.com/api/auth/oidc/callback
    frontend_redirect: /login
    scopes: openid profile email
    allowed_email_domains: ""
    auto_provision: false
    default_role_id: 0
    default_dept_id: 101
    tenant_code: default
  reverse_proxy:
    enabled: false
    prefix: /edge
    upstream: http://127.0.0.1:9000
    strip_prefix: true
    require_session: true
    permission: ""
    timeout_ms: 15000
    maximum_request_bytes: 8388608
    maximum_response_bytes: 8388608

server:
  limits:
    idle_timeout_ms: 75000
    read_timeout_ms: 60000
    write_timeout_ms: 60000
  parser_limits:
    maximum_body_size: 268435456
  rate_limit:
    requests_per_second: 0.0
    burst_capacity: 1.0

metrics:
  enabled: false
  service_name: EdgePulse
  service_version: 1.0.0
  export_interval_ms: 15000
  otlp:
    endpoint: http://otel-collector:4318/v1/metrics
    timeout_ms: 3000
