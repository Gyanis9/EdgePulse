# EdgePulse Agent 配置样例
# 相对路径按本文件所在目录解析；注册令牌与换绑令牌只从环境变量读取，不写在本文件里。

agent:
  server:
    base_url: https://127.0.0.1:9443
    ca_file: /etc/edgepulse/ca.pem
    certificate_file: /etc/edgepulse/agent.pem
    private_key_file: /etc/edgepulse/agent-key.pem
    tenant_code: default
    name: edge-01
    enrollment_token_env: EDGEPULSE_AGENT_ENROLLMENT_TOKEN
    rebind_token_env: EDGEPULSE_AGENT_REBIND_TOKEN
    heartbeat_interval_seconds: 30
    command_poll_interval_seconds: 15
    websocket_enabled: true
    request_timeout_seconds: 30
    # 只供本地测试使用；生产环境必须保持 false
    allow_plaintext_for_tests: false
  certificate:
    # 使用外部 CA 时置 false，Agent 不再启动自动续期循环；默认 true
    renewal_enabled: true
    # 续期提前量覆盖值，允许 0 到 90；0 表示按 max(25% 生命周期, 24h) 自动计算
    renew_before_days: 0
    # 多久检查一次到期时间，允许 60 到 86400 秒
    renewal_check_seconds: 3600
  telemetry:
    interval_seconds: 30
    disk_path: /
  state:
    directory: /var/lib/edgepulse-agent
  logging:
    file: /var/log/edgepulse-agent/agent.log
    level: info
    max_size_mb: 32
    max_backup: 5
  executors:
    config:
      path: /etc/edgepulse-agent/config.json
      apply_hook: ""
      maximum_bytes: 65536
    firmware:
      install_hook: /usr/local/lib/edgepulse/install-firmware.sh
      trusted_keys_dir: /etc/edgepulse/firmware-keys
      staging_directory: /var/lib/edgepulse-agent/firmware
    diagnostics:
      log_tail_bytes: 65536
  update:
    package_trusted_keys_dir: /etc/edgepulse/agent-package-keys
    installer_script: /usr/local/lib/edgepulse/install-agent.sh
    health_timeout_seconds: 60
    staging_directory: /var/lib/edgepulse-agent/update
