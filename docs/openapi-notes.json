{
  "_comment": "OpenAPI 摘要与 schema 覆盖表。paths[path][method] 支持 summary、description、requestSchema、responseSchema、security、envelope、responseStatus、responseContentType、responseDescription。responseSchema 描述包络里的 data，省略或写 Envelope 表示整个响应就是统一包络；envelope=false 表示响应体就是该 schema。responseStatus 缺省 200；responseContentType 缺省 application/json，text/csv 不得同时声明 responseSchema。security 省略时默认 Bearer，写 [] 表示匿名；方案名只能是 bearerAuth。未列出的端点由生成器给通用摘要与 Envelope；未知键或未知方案会让生成失败。",
  "paths": {
    "/api/alarm-rules": {
      "get": {
        "summary": "列出告警规则",
        "responseSchema": "AlarmRuleList"
      },
      "post": {
        "summary": "创建告警规则",
        "responseSchema": "AlarmRule"
      }
    },
    "/api/alarm-rules/{id}": {
      "put": {
        "summary": "更新告警规则",
        "responseSchema": "AlarmRule"
      },
      "delete": {
        "summary": "删除告警规则",
        "responseSchema": "Envelope"
      }
    },
    "/api/alarms": {
      "get": {
        "summary": "分页查询告警，并返回未恢复总数",
        "responseSchema": "AlarmPage"
      }
    },
    "/api/alarms/{id}": {
      "get": {
        "summary": "查询单条告警",
        "responseSchema": "Alarm"
      }
    },
    "/api/alarms/{id}/ack": {
      "put": {
        "summary": "确认告警",
        "responseSchema": "Alarm"
      }
    },
    "/api/alarms/{id}/resolve": {
      "put": {
        "summary": "恢复告警",
        "responseSchema": "Alarm"
      }
    },
    "/api/auth/captcha": {
      "get": {
        "summary": "签发一次性图形验证码",
        "responseSchema": "CaptchaChallenge",
        "security": []
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "登录；启用两步验证时先返回挑战",
        "requestSchema": "LoginRequest",
        "responseSchema": "LoginResponse",
        "security": []
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "注销当前会话",
        "responseSchema": "Envelope"
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "读取当前登录身份与权限",
        "responseSchema": "Envelope"
      }
    },
    "/api/auth/mfa": {
      "get": {
        "summary": "读取两步验证状态与剩余恢复码数量",
        "responseSchema": "MfaStatus"
      }
    },
    "/api/auth/mfa/disable": {
      "post": {
        "summary": "关闭两步验证；需要当前口令与动态码",
        "requestSchema": "MfaEnableRequest",
        "responseSchema": "Envelope"
      }
    },
    "/api/auth/mfa/enable": {
      "post": {
        "summary": "启用两步验证并返回恢复码",
        "requestSchema": "MfaEnableRequest",
        "responseSchema": "MfaRecoveryCodes"
      }
    },
    "/api/auth/mfa/recovery-codes": {
      "post": {
        "summary": "重新生成恢复码",
        "description": "整组替换现有恢复码，旧恢复码立即失效；需要当前身份未消费过的 6 位动态码。",
        "requestSchema": "MfaCodeRequest",
        "responseSchema": "MfaRecoveryCodes"
      }
    },
    "/api/auth/mfa/setup": {
      "post": {
        "summary": "开始设置两步验证，返回共享密钥与 otpauth URI",
        "requestSchema": "MfaSetupRequest",
        "responseSchema": "MfaSetupResponse"
      }
    },
    "/api/auth/mfa/verify": {
      "post": {
        "summary": "完成两步验证挑战并签发会话令牌",
        "requestSchema": "MfaVerifyRequest",
        "responseSchema": "LoginResponse",
        "security": []
      }
    },
    "/api/auth/oidc/callback": {
      "get": {
        "summary": "OIDC 回调；重定向回前端并附带一次性 oidcCode",
        "description": "成功与失败都以 302 回到前端，失败时带 oidcError。",
        "responseStatus": 302,
        "security": []
      }
    },
    "/api/auth/oidc/enabled": {
      "get": {
        "summary": "查询是否启用 OIDC 登录",
        "responseSchema": "Envelope",
        "security": []
      }
    },
    "/api/auth/oidc/exchange": {
      "post": {
        "summary": "用一次性 oidcCode 换取会话令牌",
        "description": "code 来自 OIDC 回调重定向参数，只能兑换一次；需要第二步验证时返回挑战形状。",
        "requestSchema": "OidcExchangeRequest",
        "responseSchema": "Envelope",
        "security": []
      }
    },
    "/api/auth/oidc/start": {
      "get": {
        "summary": "开始 OIDC 登录；重定向到身份提供方",
        "description": "成功时返回 302 到 IdP；return 只接受本站绝对路径。",
        "responseStatus": 302,
        "security": []
      }
    },
    "/api/auth/password": {
      "put": {
        "summary": "修改当前用户口令",
        "requestSchema": "PasswordChangeRequest",
        "responseSchema": "Envelope"
      }
    },
    "/api/auth/routes": {
      "get": {
        "summary": "读取当前用户可见的菜单树",
        "responseSchema": "Envelope"
      }
    },
    "/api/commands": {
