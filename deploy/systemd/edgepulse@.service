[Unit]
Description=EdgePulse 实例 %i
Documentation=https://github.com/Gyanis9/EdgePulse
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgepulse
Group=edgepulse
SyslogIdentifier=edgepulse-%i
WorkingDirectory=/opt/edgepulse
# %i 是实例名：/etc/edgepulse/<实例>.yaml 里放唯一的 edgepulse.instance_id，
# /etc/edgepulse/<实例>.env 放该实例的秘密（权限 0600）。同机多实例时，
# 各配置的 http_port/https_port/agent_port/ops_port 必须互不冲突。
# 日志配置放在 /etc/edgepulse/logging.yaml，与 %i.yaml 同目录；其中滚动 sink 的
# directory 要写 /var/lib/edgepulse/logs，不要写相对路径，否则会落到只读的
# /opt/edgepulse 下。StateDirectory 创建 /var/lib/edgepulse 并交给服务用户，
# ExecStartPre 再建 logs 子目录；ReadWritePaths 显式放开固件、日志与运行时配置。
StateDirectory=edgepulse
EnvironmentFile=/etc/edgepulse/%i.env
ExecStartPre=/bin/mkdir -p /var/lib/edgepulse/logs
ExecStart=/opt/edgepulse/edgepulse-server --config /etc/edgepulse/%i.yaml
Restart=on-failure
RestartSec=3s
# 与容器编排的 stop_grace_period 一致：先让 /readyz 变 503，再排空在途请求
TimeoutStopSec=40s
KillSignal=SIGTERM

# 秘密来自 EnvironmentFile（权限 0600，不进版本库）；运行目录只放开固件与数据库。
# 固件目录必须与其它实例共享，否则 HA 下固件上传与下载会落到不同机器。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edgepulse
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
