# 复制为 deploy/docker/.env（未跟踪），逐项填入真实值后再 docker compose up。
MYSQL_ROOT_PASSWORD=
EDGEPULSE_DB_PASSWORD=
EDGEPULSE_REDIS_PASSWORD=
EDGEPULSE_OPS_BEARER_TOKEN=
EDGEPULSE_AGENT_FINGERPRINT=
EDGEPULSE_INITIAL_PASSWORD=
# 种子管理员 admin 仍使用 admin123 时，应用启动期用它替换口令；两端空白会被去掉，
# 纯空白按未设置处理。口令至少 10 位且同时含大写、小写、数字与符号。留空时生产档
# 会拒绝启动；开发档（captcha.expose_code=true）或显式确认
# EDGEPULSE_ALLOW_DEFAULT_ADMIN=true 才保留 admin123。单实例与 HA 编排都会透传。
EDGEPULSE_ADMIN_PASSWORD=
# 仅本机开发或隔离验收使用：显式确认保留种子口令 admin123。生产不得开启。
EDGEPULSE_ALLOW_DEFAULT_ADMIN=false
EDGEPULSE_UDP_TELEMETRY_SECRET=
EDGEPULSE_OIDC_CLIENT_SECRET=
# 两步验证主密钥：base64 编码的 32 字节，用 openssl rand -base64 32 生成。
# 留空表示不启用两步验证；填值后同一数据库上的所有实例必须一致。
EDGEPULSE_MFA_KEY=
# HA 双实例编排读取：
# EDGEPULSE_INSTANCE_ID 由 docker-compose.ha.yml 按服务设置，不写进这里；入口脚本据此
# 在容器内生成唯一实例配置副本。单实例 compose 不读取它。值只能含字母、数字、点、
# 下划线与连字符，最长 128 字符；同时存活的实例不能重复。
# 宿主机发布地址与端口，默认值见 docker-compose.ha.yml；冲突时改这里。
# 改 8443 发布端口后，config/prod.yaml 的 security.allowed_origins 要写同一个 Origin
# （例如 https://console.example.com:8443），否则浏览器 WebSocket 升级返回 403。
# 8080 是明文入口，默认只绑回环；8443/9443 默认对外；9090 是没有鉴权的管理界面，
# 默认只绑回环。需要换网卡时显式写地址，不要用 0.0.0.0 放开明文与 Prometheus。
# EDGEPULSE_HA_HTTP_BIND_ADDRESS=127.0.0.1
# EDGEPULSE_HA_HTTP_PORT=8080
# EDGEPULSE_HA_HTTPS_BIND_ADDRESS=0.0.0.0
# EDGEPULSE_HA_HTTPS_PORT=8443
# EDGEPULSE_HA_AGENT_BIND_ADDRESS=0.0.0.0
# EDGEPULSE_HA_AGENT_PORT=9443
# EDGEPULSE_HA_PROMETHEUS_BIND_ADDRESS=127.0.0.1
# EDGEPULSE_HA_PROMETHEUS_PORT=9090
# 配置、证书与固件公钥的宿主机路径（相对 deploy/docker）。
# EDGEPULSE_HA_CONFIG_DIR=../../config
# 应用证书目录只放 ca.pem、server.pem、server-key.pem；CA 私钥不要放进来。
# 宿主文件要能被容器用户读取（Linux 上通常 chown 到容器 uid，或证书 0444、
# 私钥 0400 且属主为该 uid）。
# EDGEPULSE_HA_CERT_DIR=./certs/app
# nginx 证书目录只放 server.pem、server-key.pem，不要放 ca.pem 或任何私钥。
# EDGEPULSE_HA_NGINX_CERT_DIR=./certs/nginx
# EDGEPULSE_HA_FIRMWARE_KEYS_DIR=../../config/firmware-keys
# Agent CA 私钥的宿主机文件，不进入证书目录或镜像。只有启用控制面内部 CA 时才需要：
# 带 --profile agent-ca 启动（ca-key-init 会把私钥复制成 0400 命名卷）；使用外部 CA 时
# 不要设置它，也不要带该 profile。宿主机 chmod 0400 即可。
# EDGEPULSE_AGENT_CA_KEY_FILE=./secrets/agent-ca-key.pem
# HA 镜像名；scripts/check-ha-stack.py 会构建或复用该镜像。
# EDGEPULSE_HA_IMAGE=edgepulse:ha
